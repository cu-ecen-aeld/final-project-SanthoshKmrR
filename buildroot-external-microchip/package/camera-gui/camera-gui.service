[Unit]
Description=Camera GUI (EGT + UDP sensor) Application -- Sprint 2
# Start after the network is up and after egtdemo has settled, so the starter
# script can bring up eth0 (for UDP :5001) and stop egtdemo before launch.
After=network.target egtdemo.service
ConditionPathExists=/dev/dri/card0

[Service]
Type=simple
ExecStart=/usr/bin/camera-gui-start.sh
Restart=on-failure

[Install]
WantedBy=multi-user.target
